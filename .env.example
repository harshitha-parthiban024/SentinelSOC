# Copy this file to .env and fill in values as needed.
# The app runs fully functional with zero AI keys (falls back to
# template-based analyst narratives).

# --- Database (required) ---------------------------------------------------
# Local MongoDB (see docker-compose.yml — `docker compose up -d mongo`):
MONGODB_URI=mongodb://127.0.0.1:27017/sentinel_soc
# Or MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/sentinel_soc
MONGODB_DB_NAME=

# --- Server ------------------------------------------------------------------
PORT=3000

# --- Optional AI narrative generation ---------------------------------------
# Leave AI_PROVIDER=none to use the built-in deterministic narrative fallback.
AI_PROVIDER=none
# AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Default recon target on first load ("juice-shop" or "ginandjuice")
DEFAULT_TARGET_ID=juice-shop
